/**
 * @defgroup DspCore_BuildGuide Build Guide
 * @brief Configure a DspCore source build.
 *
 * DspCore locates or fetches Foundation automatically (see
 * @ref DspCore_BuildGuide_Dependency):
 *
 * @code{.bash}
 * ./scripts/configure.sh macos_arm64 --fresh
 * ./scripts/build.sh macos_arm64 --config Debug
 * @endcode
 *
 * To work on DspCore together with a local Foundation checkout, use CMake's
 * FetchContent source override:
 *
 * @code{.bash}
 * ./scripts/configure.sh macos_arm64 --fresh -- \
 *   -DFETCHCONTENT_SOURCE_DIR_FOUNDATION=../Foundation
 * @endcode
 */
